# ── URL CANONICALISATION ──────────────────────────────
# Redirect /index.html to / (clean URL)
# Redirect non-www to www

RewriteEngine On

# 1. Remove index.html from URL
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index\.html[\s?]
RewriteRule ^index\.html$ https://www.thetutorment.com/ [R=301,L]

# 2. Redirect non-www to www
RewriteCond %{HTTP_HOST} ^thetutorment\.com [NC]
RewriteRule ^(.*)$ https://www.thetutorment.com/$1 [R=301,L]

# 3. Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://www.thetutorment.com/$1 [R=301,L]

# ── SECURITY HEADERS ──────────────────────────────────
# The Tutorment — Security Headers
# Fixes: CSP, HSTS, COOP, XFO, Best Practices score

# HSTS — force HTTPS for 1 year
Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains" env=HTTPS

# Clickjacking protection
Header always set X-Frame-Options "SAMEORIGIN"

# XSS protection
Header always set X-XSS-Protection "1; mode=block"

# Content type sniffing
Header always set X-Content-Type-Options "nosniff"

# Referrer policy
Header always set Referrer-Policy "strict-origin-when-cross-origin"

# COOP — cross origin isolation
Header always set Cross-Origin-Opener-Policy "same-origin-allow-popups"

# CSP — allow scripts from self and inline (needed for our inline scripts)
Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.gstatic.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://tutorment-backend-wjew.onrender.com; frame-ancestors 'self';"

# Compression — speeds up delivery
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json

# JS files: short cache so updates are picked up quickly
<FilesMatch "\.js$">
  Header set Cache-Control "max-age=3600, must-revalidate"
</FilesMatch>
</IfModule>

# Browser caching — static assets cached for 1 year
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 hour"
  ExpiresByType text/javascript "access plus 1 hour"
</IfModule>

# Prevent directory listing
Options -Indexes

# Handle clean URLs for pages
ErrorDocument 404 /pages/404.html
